{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/main.py",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    },
    {
      "name": "Backend: CLI Drone Detector",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/detect.py",
      "cwd": "${workspaceFolder}/backend",
      "args": ["--source", "test_drone.mp4", "--headless"],
      "console": "integratedTerminal"
    }
  ]
}
