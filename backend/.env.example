# ==============================================================================
# AERO-GUARD Backend Environment Configuration Template
# ==============================================================================

# Replicate Cloud API Token for Generative Aerial Diffusion
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Computer Vision Models (Ground CCTV & Aerial Drone)
# Pin custom fine-tuned checkpoints in backend/models/
GROUND_MODEL_NAME=yolo26n.pt
AERIAL_MODEL_NAME=visdrone_person_best.pt
# visdrone for high-altitude footage; general for closer/elevated people.
AERIAL_DETECTION_PROFILE=visdrone

# Module 3: run setup_reid.py --install-source --download-weights first.
DETECTION_DEVICE=cpu
REID_ENABLED=true
REID_DEVICE=cpu
REID_CPU_THREADS=2
# sequential reads every uploaded frame; realtime skips ahead to wall-clock time.
VIDEO_PLAYBACK_MODE=realtime
# Hold completed clips so slow CPU matching can finish. Replay starts a new session.
VIDEO_END_BEHAVIOR=hold
DEVICE_RTSP_TIMEOUT_US=5000000
DEVICE_CAPTURE_BUFFER_SIZE=1
DEVICE_READ_RETRY_SECONDS=0.04
# Manual movement is simulated until explicitly set to tello.
DRONE_CONTROL_MODE=simulation
TELLO_HOST=192.168.10.1
TELLO_COMMAND_PORT=8889
TELLO_LOCAL_PORT=9000
TELLO_COMMAND_TIMEOUT_SECONDS=10
TELLO_SEND_INTERVAL_SECONDS=0.05
TELLO_INPUT_TIMEOUT_SECONDS=0.6
# Preview runs independently; detection consumes the newest available frame.
STREAM_ASYNC_PREVIEW=true
STREAM_PREVIEW_FPS=25
STREAM_BOX_MAX_AGE_SECONDS=1.0
# Defaults resolve from the project root; absolute paths are also supported.
# REID_SOURCE_DIR=/workspace/Drone-Detect-Person-/.runtime/X-TFCLIP
# REID_CHECKPOINT=/workspace/Drone-Detect-Person-/backend/models/xtfclip.pth.tar
# REID_CHECKPOINT_SHA256=<hash of the verified official checkpoint>
# Official AG-VPReID mapping: C0/C1 CCTV; C2/C3 wearable; C4/C5 UAV.
# These are representative domain labels; evaluate them on your own cameras.
REID_CAMERA_MODE=mapped
REID_GROUND_CAMERA_ID=0
REID_AERIAL_CAMERA_ID=4
REID_SEQUENCE_LENGTH=8
REID_CROP_HEIGHT=288
REID_CROP_WIDTH=144
REID_SAMPLE_SECONDS=0.3
REID_UPDATE_SECONDS=2
REID_TRACK_TTL_SECONDS=120
REID_MAX_TRACKS=48
REID_MAX_TARGETS=4
REID_TOP_K=4
REID_BATCH_SIZE=1
REID_MIN_CROP_HEIGHT=32
REID_MIN_CROP_WIDTH=12
REID_MIN_DETECTION_CONFIDENCE=0.4
# -1 means ranking only. A threshold is not calibrated until tested on your footage.
REID_MIN_SIMILARITY=-1
REID_WORKER_TIMEOUT_SECONDS=180
REID_FLIP_AUGMENTATION=true

# Streaming/acquisition settings (all time values below are seconds).
STREAM_JPEG_QUALITY=80
STREAM_RETRY_SECONDS=0.04
STREAM_THROTTLE_SECONDS=0.015
STREAM_HTTP_TIMEOUT_SECONDS=2.5
STREAM_MAX_FRAME_WIDTH=1280
SIMULATION_WIDTH=1280
SIMULATION_HEIGHT=720
SIMULATION_PERSON_COUNT=4
SIMULATION_INTERVAL_SECONDS=0.035
BLOCKED_WEBCAM_DEVICE=0
WORKER_SHUTDOWN_SECONDS=3
REID_PROCESS_SHUTDOWN_SECONDS=2
WS_TELEMETRY_INTERVAL_SECONDS=0.12
DB_CONNECTION_TIMEOUT_SECONDS=20
DB_BUSY_TIMEOUT_MS=10000
FPS_WINDOW_SECONDS=0.5
# Optional profile overrides, applied after registry defaults:
# GROUND_CONFIDENCE=0.35
# GROUND_IOU=0.5
# GROUND_IMAGE_SIZE=640
# AERIAL_CONFIDENCE=0.25
# AERIAL_IOU=0.45
# AERIAL_IMAGE_SIZE=640
# Optional absolute storage directory overrides:
# RUNS_DIR=/absolute/path/to/runs
# SNAPSHOTS_DIR=/absolute/path/to/snapshots
# RECORDINGS_DIR=/absolute/path/to/recordings
# UPLOADS_DIR=/absolute/path/to/uploads
# CAMERA_FLEET_JSON=[...]
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CAMERA_PROBE_TIMEOUT_SECONDS=2.0
